# Copy to .env (git-ignored). Loaded by `npm run dev`.
# Everything is optional locally: unset vars use the defaults in
# src/config/config.js, shown commented out below.

# Entra ID — set the first three to sign in against real Entra (defradev
# tenant) instead of the local stub
# ENTRA_CLIENT_ID=local-client-id
# ENTRA_CLIENT_SECRET=local-client-secret
# ENTRA_DISCOVERY_URI=http://localhost:3210/entra/.well-known/openid-configuration
# ENTRA_REQUIRED_ROLE=Admin
# ENTRA_SCOPES=openid profile email offline_access user.read
# form_post | query; form_post needs HTTPS
# ENTRA_RESPONSE_MODE=
# APP_BASE_URL=http://localhost:3000

# Server
# NODE_ENV=development
# HOST=0.0.0.0
# PORT=3000
# SERVICE_VERSION=
# ASSET_PATH=/public
# STATIC_CACHE_TIMEOUT=604800000
# ENABLE_SECURE_CONTEXT=false
# HTTP_PROXY=
# TRACING_HEADER=x-cdp-request-id

# Logging
# LOG_ENABLED=true
# LOG_LEVEL=info
# ecs | pino-pretty
# LOG_FORMAT=pino-pretty
# LOG_REDACT=

# Session
# memory | redis
# SESSION_CACHE_ENGINE=memory
# SESSION_CACHE_NAME=session
# SESSION_CACHE_TTL=14400000
# SESSION_COOKIE_TTL=14400000
# SESSION_COOKIE_PASSWORD=the-password-must-be-at-least-32-characters-long
# SESSION_COOKIE_SECURE=false

# Redis (only when SESSION_CACHE_ENGINE=redis)
# REDIS_HOST=127.0.0.1
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_KEY_PREFIX=waste-batteries-admin-panel-fe:
# REDIS_TLS=false
# USE_SINGLE_INSTANCE_CACHE=true
